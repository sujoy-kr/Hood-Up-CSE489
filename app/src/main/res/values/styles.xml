<resources>
    <!-- Text -->
    <style name="TextBody" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="ScreenTitle" parent="TextBody">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>
    <style name="SectionHeader" parent="TextBody">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MutedText" parent="TextBody">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Caption" parent="MutedText">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
    <style name="Overline" parent="TextBody">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
    <style name="FieldLabel" parent="MutedText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/spacing_half</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="InlineError" parent="MutedText">
        <item name="android:textColor">@color/danger</item>
        <item name="android:paddingTop">@dimen/spacing_half</item>
        <item name="android:accessibilityLiveRegion">polite</item>
    </style>
    <style name="StatusPill" parent="TextBody">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Buttons -->
    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">@dimen/spacing</item>
        <item name="android:paddingEnd">@dimen/spacing</item>
    </style>
    <style name="SecondaryButton" parent="PrimaryButton">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>
    <style name="DangerButton" parent="PrimaryButton">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/btn_danger_text</item>
    </style>
    <style name="SmallButton" parent="SecondaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="SmallDangerButton" parent="SmallButton">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/btn_danger_text</item>
    </style>
    <style name="TextLink" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
    </style>
    <style name="Chip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/chip_default</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">@dimen/spacing</item>
        <item name="android:paddingEnd">@dimen/spacing</item>
    </style>
    <style name="SelectedChip" parent="Chip">
        <item name="android:background">@drawable/chip_selected</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="MenuRow" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/spacing</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">@dimen/spacing</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:drawableTint">@color/text_muted</item>
    </style>
    <style name="NavItem" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/nav_item</item>
        <item name="android:drawableTint">@color/nav_item</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">@dimen/spacing_half</item>
    </style>

    <!-- Inputs -->
    <style name="TextInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">@dimen/spacing</item>
        <item name="android:paddingEnd">@dimen/spacing</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Structure -->
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">@dimen/spacing</item>
    </style>
    <style name="BarTitle" parent="TextBody">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">@dimen/spacing_half</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/spacing</item>
        <item name="android:layout_marginBottom">@dimen/spacing</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/stroke_width</item>
        <item name="android:background">@color/stroke</item>
    </style>
    <style name="IconTile">
        <item name="android:layout_width">@dimen/icon_tile</item>
        <item name="android:layout_height">@dimen/icon_tile</item>
        <item name="android:background">@drawable/bg_card_alt</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/primary</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Loader">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">@dimen/spacing</item>
        <item name="android:indeterminateTint">@color/accent</item>
    </style>
    <style name="CardList">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:scrollbars">none</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingStart">@dimen/spacing</item>
        <item name="android:paddingEnd">@dimen/spacing</item>
    </style>
    <style name="OfflineBanner" parent="Caption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/surface_alt</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/spacing_half</item>
    </style>
</resources>
