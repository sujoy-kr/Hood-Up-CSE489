<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
    <TextView android:id="@+id/offline_banner" style="@style/OfflineBanner"
        android:text="@string/offline_banner" android:visibility="gone" />
    <TextView android:id="@+id/form_error" style="@style/InlineError" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing" android:paddingEnd="@dimen/spacing" android:visibility="gone" />
    <ListView android:id="@+id/booking_list" style="@style/CardList" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <include layout="@layout/nav_bar" />
</LinearLayout>
