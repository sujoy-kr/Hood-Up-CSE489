<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="@dimen/spacing_half">
    <ImageView android:id="@+id/detail_image" android:layout_width="match_parent"
        android:layout_height="200dp" android:layout_marginBottom="@dimen/spacing"
        android:background="@drawable/bg_card" android:scaleType="centerCrop"
        android:src="@drawable/workshop_day" android:importantForAccessibility="no" />
    <TextView android:id="@+id/detail_name" style="@style/ScreenTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_half" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView android:id="@+id/detail_rating" style="@style/MutedText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="12dp" android:textColor="@color/warning" android:textStyle="bold" />
        <TextView android:id="@+id/detail_hours" style="@style/MutedText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:drawableStart="@drawable/ic_clock_small" android:drawablePadding="6dp"
            android:drawableTint="@color/text_muted" android:gravity="center_vertical" />
    </LinearLayout>
    <TextView android:id="@+id/detail_address" style="@style/TextBody" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" android:drawableStart="@drawable/ic_pin_small"
        android:drawablePadding="6dp" android:drawableTint="@color/accent" />
    <TextView android:id="@+id/detail_description" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing" android:textSize="@dimen/text_body" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="@dimen/spacing_large">
        <Button android:id="@+id/call" style="@style/SecondaryButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_half" android:text="@string/call_workshop" />
        <Button android:id="@+id/directions" style="@style/SecondaryButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_half" android:text="@string/directions_workshop" />
    </LinearLayout>
    <TextView style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:text="@string/offered_services" />
    <ProgressBar android:id="@+id/browse_progress" style="@style/Loader" />
    <TextView android:id="@+id/browse_status" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing" android:text="@string/detail_loading"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
