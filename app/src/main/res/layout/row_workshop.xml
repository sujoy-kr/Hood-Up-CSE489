<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/spacing">
    <LinearLayout android:id="@+id/row_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:background="@drawable/bg_card" android:foreground="@drawable/fg_card_ripple"
        android:padding="@dimen/stroke_width">
        <ImageView android:id="@+id/row_image" android:layout_width="match_parent"
            android:layout_height="148dp" android:scaleType="centerCrop"
            android:src="@drawable/workshop_day" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/row_name" style="@style/SectionHeader" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2"
                    android:ellipsize="end" />
                <TextView android:id="@+id/row_rating" style="@style/MutedText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_half" android:textColor="@color/warning"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/row_area" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:drawableStart="@drawable/ic_pin_small"
                android:drawablePadding="6dp" android:drawableTint="@color/text_muted"
                android:gravity="center_vertical" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginTop="12dp">
                <TextView android:id="@+id/row_open" style="@style/StatusPill" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/chip_default" android:text="@string/closed_now" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:id="@+id/row_price" style="@style/TextBody" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/primary" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
