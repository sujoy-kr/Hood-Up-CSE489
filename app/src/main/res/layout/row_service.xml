<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
    <LinearLayout style="@style/Card" android:layout_marginBottom="0dp">
        <TextView android:id="@+id/service_name" style="@style/SectionHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/service_description" style="@style/MutedText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView android:id="@+id/service_price" style="@style/TextBody" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:textColor="@color/primary" android:textStyle="bold" />
            <Button android:id="@+id/book_service" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="44dp" android:minWidth="96dp" android:text="@string/book_service" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
